# Copia este archivo a .env.local y llena los valores.
# Local: `npm run db:start` imprime la URL y las keys (o `npx supabase status`).
# Staging/producción: Supabase → Project Settings → API Keys.

# Públicas (llegan al navegador). Solo la publishable key, nunca la secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Se salta RLS: nunca en variables NEXT_PUBLIC_ ni en código de cliente.
SUPABASE_SECRET_KEY=
